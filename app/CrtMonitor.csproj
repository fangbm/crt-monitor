<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CrtMonitor</AssemblyName>
    <RootNamespace>CrtMonitor</RootNamespace>
    <Version>1.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <!-- 主题文件与前端插件脚本随构建/发布拷贝 -->
  <ItemGroup>
    <None Include="..\themes\**\*.json" LinkBase="themes" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\plugins\**\*.js" LinkBase="plugins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 前端产物拷贝到输出目录 wwwroot/ -->
  <Target Name="CopyFrontend" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\dist')">
    <ItemGroup>
      <FrontendAssets Include="$(MSBuildProjectDirectory)\..\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendAssets)"
          DestinationFiles="@(FrontendAssets->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyFrontendToPublish" AfterTargets="Publish" Condition="Exists('$(MSBuildProjectDirectory)\..\dist')">
    <ItemGroup>
      <FrontendAssets Include="$(MSBuildProjectDirectory)\..\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendAssets)"
          DestinationFiles="@(FrontendAssets->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
